# Copy this file to .env and fill in your values.

# --- Required ---
OPENAI_API_KEY=

# --- Optional ---

# UI Mode: set to "true" to enable CLI output
CLI_MODE=false

# Port for the reminders AppleScript proxy (must run on Mac host)
REMINDERS_PROXY_PORT=8765

# Host-side ports for Docker services
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000
